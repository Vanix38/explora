{
  "name": "explora",
  "version": "1.1.0",
  "description": "Navigateur de bureau perso pour passer facilement d'un moteur de recherche ou d'une IA à l'autre",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "icon": "electron scripts/make-icon.js",
    "postinstall": "install-electron"
  },
  "author": "Vanix38",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Explora",
  "build": {
    "appId": "com.vanix38.explora",
    "productName": "Explora",
    "copyright": "Vanix38",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "src/devtools-ext/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Explora",
      "uninstallDisplayName": "Explora",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Explora-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  }
}
